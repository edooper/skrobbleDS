LASTFM_API_KEY=<your lastfm key>
LASTFM_API_SECRET=<your lastfm secret>
LOG_FILE=true
DEBUG=false
WEBUI_PORT=9099
CONFIG_DIR=config

# Run the container as this host user/group so the bind-mounted ./config
# directory is writable (needed on Synology/NAS). Run `id` on the host to
# find your values, e.g. uid=1026 gid=100 -> PUID=1026, PGID=100.
PUID=1000
PGID=100
